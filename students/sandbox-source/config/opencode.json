{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "opencode/deepseek-v4.1-flash-free",
  "share": "disabled",

  // ─── Платные модели: только через локальный прокси (контейнер gateway) ─────
  // Каталоговые провайдеры (`opencode-go`, `vercel`) содержат десятки моделей,
  // и почти все платные — студент выбрал бы дорогую и съел баланс подписки.
  // Ограничить каталог нельзя: whitelist/blacklist на каталоговые модели не
  // действуют (проверено), provider.use фильтрует только по провайдеру.
  //
  // Поэтому провайдер объявлен СВОИМ блоком с явным списком моделей: в UI
  // студент видит ровно то, что перечислено ниже. Каталоговый провайдер с тем
  // же именем при этом скрыт политикой provider.use (см. policies).
  //
  // baseURL указывает на ЛОКАЛЬНЫЙ прокси, а не к провайдеру: настоящий ключ в
  // песочнице не лежит. Иначе агент достаёт его из /proc/self/environ и уходит
  // к провайдеру любой моделью через urllib (curl/wget запрещены политикой,
  // urllib — нет), минуя и список моделей, и лимит. Прокси пропускает только
  // модели из своего белого списка.
  //
  // apiKey здесь — заглушка: прокси подставляет настоящий ключ сам.
  "provider": {
    // ── go-cheap (OpenCode Go, подписка) — был удалён 2026-10-27 ──────────────
    // Причина удаления: ключ подписки лежал в config в песочнице, и агент
    // студента мог достать его одной командой (`opencode auth export`,
    // SQLite-БД, environ). Теперь подписка вернулась — но ключ живёт только в
    // контейнере gateway, а этот блок ходит через локальный прокси.
    //
    // ── ПРОВАЙДЕР `muse-go` (подписка OpenCode Go, через локальный прокси) ─────
    // Имя НЕ `opencode-go`: у подписки есть встроенный каталоговый провайдер с
    // таким именем, и блок в конфиге сливается с ним — в UI всплывают все 30
    // моделей подписки, а сервер требует логин («Invalid credential»). Своё имя
    // даёт ровно те модели, что перечислены ниже.
    // Модели Go платные, поэтому ключ подписки лежит НЕ здесь, а в контейнере
    // gateway (OPENCODE_GO_API_KEY в .env хоста). В песочнице — только адрес
    // локального прокси и заглушка вместо ключа. Прокси пропускает исключительно
    // модели из GO_ALLOWED_MODELS, всё остальное отдаёт 403.
    // Список в config и GO_ALLOWED_MODELS в .env должны совпадать.
    "muse-go": {
      "npm": "@opencode/ai/providers/openai-compatible",
      "options": {
        "baseURL": "http://gateway:8080/v1",
        "apiKey": "local-proxy"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (Go, платная — учится на запросах)"
        }
      }
    }
  },

  // ─── Какие модели видны студентам ─────────────────────────────────────────
  // Каталог провайдера `opencode` отдаёт 7 бесплатных моделей — все делят один
  // общий бесплатный пул, который 28.10.2026 выбрался за одну пару. Поэтому на
  // стенде оставлены три рабочие (deepseek — дефолт, glm, mimo), остальные
  // скрыты. Файл смонтирован как managed-конфиг (/etc/opencode/), значит из UI
  // студент скрытую модель не вернёт — вернуть может только root.
  // Ключ V2 — `providers`; в V1-ключе `provider` поле disabled игнорируется.
  "providers": {
    "opencode": {
      "models": {
        "flint-40b-free":              { "disabled": true },
        "beam-free":                   { "disabled": true },
        "nemotron-3.5-lightning-free": { "disabled": true },
        "nemotron-3.5-super-vl-free":  { "disabled": true }
      }
    }
  },

  "tool_output": {
    "max_lines": 400,
    "max_bytes": 32768
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1600,
      "max_height": 1600,
      "max_base64_bytes": 2097152
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "webfetch",  "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "python *",  "effect": "allow" },
    { "action": "shell", "resource": "uv *",      "effect": "allow" },
    { "action": "shell", "resource": "ls *",      "effect": "allow" },
    { "action": "shell", "resource": "cat *",     "effect": "allow" },
    { "action": "shell", "resource": "head *",    "effect": "allow" },
    { "action": "shell", "resource": "tail *",    "effect": "allow" },
    { "action": "shell", "resource": "wc *",      "effect": "allow" },
    { "action": "shell", "resource": "grep *",    "effect": "allow" },
    { "action": "shell", "resource": "find *",    "effect": "allow" },
    { "action": "shell", "resource": "sort *",    "effect": "allow" },
    { "action": "shell", "resource": "uniq *",    "effect": "allow" },
    { "action": "shell", "resource": "cut *",     "effect": "allow" },
    { "action": "shell", "resource": "sed *",     "effect": "allow" },
    { "action": "shell", "resource": "awk *",     "effect": "allow" },
    { "action": "shell", "resource": "mkdir *",   "effect": "allow" },
    { "action": "shell", "resource": "cp *",      "effect": "allow" },
    { "action": "shell", "resource": "mv *",      "effect": "allow" },
    { "action": "shell", "resource": "touch *",   "effect": "allow" },
    { "action": "shell", "resource": "echo *",    "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *",   "effect": "allow" },
    { "action": "shell", "resource": "git log *",    "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "read", "resource": "**/.env",     "effect": "deny" },
    { "action": "read", "resource": "**/.env.*",   "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**",  "effect": "deny" },
    { "action": "read", "resource": "**/.aws/**",  "effect": "deny" },
    { "action": "read", "resource": "**/.config/opencode/**", "effect": "deny" },
    { "action": "read", "resource": "**/opencode.db",          "effect": "deny" },
    { "action": "read", "resource": "/etc/**",     "effect": "deny" },
    { "action": "edit", "resource": "/etc/**",     "effect": "deny" },
    { "action": "edit", "resource": "**/.config/opencode/**", "effect": "deny" }
  ],
  "policies": [
    { "action": "provider.use", "resource": "*",           "effect": "deny"  },
    { "action": "provider.use", "resource": "opencode",    "effect": "allow" },
    // Провайдер подписки. Разрешён, но в UI у него ровно одна модель, а ключ
    // лежит в контейнере gateway — в песочнице его нет.
    { "action": "provider.use", "resource": "muse-go",     "effect": "allow" },
    { "action": "tool.use", "resource": "webfetch:*",  "effect": "deny" },
    { "action": "tool.use", "resource": "websearch:*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *",      "effect": "deny" },
    { "action": "tool.use", "resource": "shell:su *",        "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ssh *",       "effect": "deny" },
    { "action": "tool.use", "resource": "shell:scp *",       "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sftp *",      "effect": "deny" },
    { "action": "tool.use", "resource": "shell:curl *",      "effect": "deny" },
    { "action": "tool.use", "resource": "shell:wget *",      "effect": "deny" },
    { "action": "tool.use", "resource": "shell:nc *",        "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ncat *",      "effect": "deny" },
    { "action": "tool.use", "resource": "shell:telnet *",    "effect": "deny" },
    { "action": "tool.use", "resource": "shell:nmap *",      "effect": "deny" },
    { "action": "tool.use", "resource": "shell:mount *",     "effect": "deny" },
    { "action": "tool.use", "resource": "shell:umount *",    "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker *",    "effect": "deny" },
    { "action": "tool.use", "resource": "shell:systemctl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pip install *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:apt *",       "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *",   "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git remote *", "effect": "deny" }
  ],
  "skills": [],
  "instructions": [
    "/etc/opencode/skills/economist-sandbox/SKILL.md"
  ],
  "default_agent": "economist",
  "agents": {
    "economist": {
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  }
}
