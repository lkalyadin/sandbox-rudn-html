# ─── Стенд «OpenCode для студентов-экономистов» ───────────────────────────────
# Скопируйте в .env и поменяйте пароль. .env в git не попадает.

# Пароль веб-интерфейса OpenCode. Логин всегда: opencode
# Именно эта пара — единственный вход для студентов.
SANDBOX_PASSWORD=please-change-me

# Образ OpenCode. Проверьте актуальный тег: https://github.com/anomalyco/opencode/pkgs/container/opencode
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:2.0.0

# Изоляция контейнера.
#   runsc — gVisor (рекомендуется, ставится скриптом 10-install-gvisor.sh)
#   runc  — обычный Docker, если gVisor ещё не установлен
SANDBOX_RUNTIME=runsc

# Лимиты на песочницу. 20–30 студентов в одном контейнере — считайте,
# что это общий CPU. На VPS 4 vCPU / 8 ГБ ставим почти всё.
SANDBOX_CPUS=3.5
SANDBOX_MEMORY=6g
SANDBOX_PIDS=512

# От чьего имени работает песочница внутри контейнера.
# Должно совпадать с владельцем каталога workspace/ на хосте, иначе студенты
# не смогут писать в /work. Посмотреть: stat -c '%u:%g' workspace
SANDBOX_UID=1000
SANDBOX_GID=1000

# ─── Внешний край ─────────────────────────────────────────────────────────────
# Порт, который открыт наружу (на него ведёт URL студентов).
EDGE_PORT=80

# TLS. Включите, если есть домен и сертификат (или self-signed).
# При ENABLE_TLS=false студенты ходят по http://<IP>:<EDGE_PORT> — ноль трения.
ENABLE_TLS=false
EDGE_HTTPS_PORT=443
# Положите сюда fullchain.pem и privkey.pem, либо оставьте пустым —
# edge сам сгенерирует self-signed сертификат.
TLS_CERT_DIR=./edge/certs
